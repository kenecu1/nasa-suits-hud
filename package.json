{
  "name": "nasa-suits-hud",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "npm run check:fast && npm run e2e",
    "check:fast": "npm run lint:py && npm run test:py && npm run contract -- --check && npm run typecheck && npm run lint && npm run test:client",
    "lint:py": "node scripts/py.mjs -m ruff check backend scripts",
    "test:py": "node scripts/py.mjs -m pytest backend -q",
    "contract": "node scripts/contract.mjs",
    "typecheck": "npm run typecheck --workspace client && tsc --noEmit -p e2e",
    "lint": "eslint . --max-warnings 0",
    "test:client": "npm run test --workspace client",
    "tss:smoke": "node scripts/py.mjs scripts/tss_smoke.py",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=22"
  }
}
